pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/45-Ashok/student-attendance.git'
            }
        }

        stage('Install Dependencies') {
    steps {
        bat 'py -m pip install -r requirements.txt'
    }
}

stage('Run Tests') {
    steps {
        bat 'py -m pytest'
    }
}
    }
}
